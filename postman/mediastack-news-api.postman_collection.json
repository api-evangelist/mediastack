      "item": [
        {
          "name": "Search Live News Articles",
          "id": "2f092365-605c-427c-819f-6ef096a798fa",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/news?access_key=<string>&sources=<string>&categories=sports&countries=<string>&languages=pt&keywords=<string>&date=3258-76-70,2980-19-54&sort=published_desc&limit=25&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "news"
              ],
              "query": [
                {
                  "description": "(Required) Mediastack API access key.",
                  "key": "access_key",
                  "value": "<string>"
                },
                {
                  "description": "Comma-separated list of source identifiers to include or exclude (prefix with `-` to exclude).",
                  "key": "sources",
                  "value": "<string>"
                },
                {
                  "description": "Comma-separated list of categories to include or exclude (prefix with `-` to exclude).",
                  "key": "categories",
                  "value": "sports"
                },
                {
                  "description": "Comma-separated list of ISO 3166-1 alpha-2 country codes to include or exclude.",
                  "key": "countries",
                  "value": "<string>"
                },
                {
                  "description": "Comma-separated list of ISO 639-1 language codes to include or exclude.",
                  "key": "languages",
                  "value": "pt"
                },
                {
                  "description": "Free-text keywords to search across article title, description, and body.",
                  "key": "keywords",
                  "value": "<string>"
                },
                {
                  "description": "Filter by publication date or date range (paid plans only).\nSingle date `YYYY-MM-DD` or range `YYYY-MM-DD,YYYY-MM-DD`.\n",
                  "key": "date",
                  "value": "3258-76-70,2980-19-54"
                },
                {
                  "description": "Sort order for results.",
                  "key": "sort",
                  "value": "published_desc"
                },
                {
                  "description": "Number of results per page (max 100).",
                  "key": "limit",
                  "value": "25"
                },
                {
                  "description": "Pagination offset.",
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Retrieve live, real-time news articles aggregated from thousands of publishers worldwide.\nFilter by source, category, country, language, keywords, and date. Supports pagination\nthrough limit/offset. The `date` parameter enables historical lookups on paid plans.\n"
