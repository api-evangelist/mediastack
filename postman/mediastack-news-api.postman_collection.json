  "info": {
    "_postman_id": "dfd4d30e-0bc7-402d-bb7e-cff44394cdbd",
    "name": "Mediastack News API",
    "description": "Mediastack is a free, simple REST API for live, historical, and blog news articles\naggregated from over 7,500 news sources across more than 50 countries and 13 languages.\nOperated by apilayer, mediastack exposes JSON endpoints for news search, news source\ndiscovery, and date-bounded historical news retrieval.\n\n\nContact Support:\n Name: Mediastack Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T02:09:02.000Z",
    "updatedAt": "2026-07-28T02:09:03.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-dfd4d30e-0bc7-402d-bb7e-cff44394cdbd"
  },
